# Resource endpoint - NO /api/projects/... suffix.
# From the Azure portal, Keys and Endpoint blade on the Foundry resource.
FOUNDRY_RESOURCE_ENDPOINT="https://your-resource.services.ai.azure.com"

# API key from the same blade. Never committed - .env is gitignored.
FOUNDRY_API_KEY="your-key-here"

# Deployment name - what code passes as model=, not the model name.
MODEL_DEPLOYMENT_NAME="gpt-5-mini"

# Entra ID path (blocked in the sandbox environment, kept for reference):
# FOUNDRY_PROJECT_ENDPOINT="https://your-resource.services.ai.azure.com/api/projects/your-project"